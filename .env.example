# GEMINI_API_KEY: Required for Gemini AI API calls (Turkish ASR, Pakistani Urdu Translation, Urdu TTS).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Media Processing Configuration
PORT=3000
MAX_UPLOAD_GB=10
MAX_DURATION_MINUTES=180
CHUNK_DURATION_SECONDS=90
CHUNK_OVERLAP_SECONDS=6
SHORT_CLIP_TEST_MINUTES=10

# Gemini Free Tier Queue Pacing & Optional Local Daily Caps
GEMINI_TTS_MIN_INTERVAL_MS=4500
GEMINI_API_MIN_INTERVAL_MS=1200
# GEMINI_TTS_DAILY_LIMIT=
# GEMINI_TEXT_DAILY_LIMIT=

# Optional External Provider Endpoints (modular overrides)
# SOURCE_SEPARATION_URL: Optional HTTP endpoint for Demucs/Spleeter stem separation
SOURCE_SEPARATION_URL=""
# EXTERNAL_STT_PROVIDER: Optional custom Turkish ASR override ("gemini" default)
EXTERNAL_STT_PROVIDER="gemini"
# EXTERNAL_TTS_PROVIDER: Optional custom Urdu TTS override ("gemini" default)
EXTERNAL_TTS_PROVIDER="gemini"

# Storage & Session Security
STORAGE_PROVIDER="local"
SESSION_SECRET="change-this-in-production"
